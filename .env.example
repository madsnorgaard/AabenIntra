# Copy to .env on VPS2 (~/docker/aabenintra.fenixnordic.solutions/.env) and fill
# in real values. This file is the production deploy gate; the pipeline skips
# any project without it. NEVER commit the real .env.

# Database
DB_NAME=aabenintra
DB_USER=aabenintra
DB_PASS=CHANGE_ME
DB_HOST=aabenintra_db
DB_PORT=3306

# Drupal
# Generate with: openssl rand -hex 32
HASH_SALT=CHANGE_ME_GENERATE_RANDOM_STRING
# Regex of allowed hostnames (escape the dots).
TRUSTED_HOSTS=aabenintra\.fenixnordic\.solutions

# Redis
REDIS_HOST=aabenintra_redis

# SMTP (mail delivery via the madsnorgaard.net mail server)
SMTP_HOST=mail.madsnorgaard.net
SMTP_PORT=587
SMTP_PROTOCOL=tls
SMTP_USER=mads@madsnorgaard.net
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=mads@madsnorgaard.net

# Observability (docs/OBSERVABILITY.md)
APP_ENV=production
# Tenant slug: label in logs and Sentry (empty = the TRUSTED_HOSTS hostname) and
# prefix of the Traefik router/middleware names in docker-compose.hardening.yml
# (empty = aabenintra).
TENANT=
# Minimum level written to the container log: debug|info|notice|warning|error
LOG_LEVEL=info
# 1 = also keep the watchdog table (Reports > Recent log messages); 0 = stdout only
LOG_DBLOG=0
# 1 = truncate client IPs in logs (IPv4 /24, IPv6 /64) - GDPR data minimisation
LOG_ANONYMIZE_IP=1
# Sentry or GlitchTip DSN. Empty = error tracking off (the raven module stays inert).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Share of requests traced for performance (0 disables tracing, 1 traces all)
SENTRY_TRACES_SAMPLE_RATE=0.05
# Only for docker-compose.logging.yml (self-hosters without their own Loki shipper)
LOKI_URL=http://loki:3100/loki/api/v1/push

# Edge hardening (docker-compose.hardening.yml). All optional; the defaults
# shown are used when unset. See docs/TRAEFIK-HARDENING.md.
#TENANT_HOST=aabenintra.fenixnordic.solutions
#RL_GENERAL_AVG=100
#RL_GENERAL_BURST=200
#RL_LOGIN_AVG=10
#RL_LOGIN_BURST=20
#RL_API_AVG=30
#RL_API_BURST=60
#INFLIGHT_MAX=100
#UPLOAD_MAX_BYTES=67108864

# Backups (scripts/backup_tenant.sh). See docs/BACKUPS.md.
#BACKUP_RETENTION_DAYS=30
#BACKUP_WEEKLY_KEEP_WEEKS=12
#OFFSITE_TARGET=
